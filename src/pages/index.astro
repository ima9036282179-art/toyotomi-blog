---
import BaseLayout from '../layouts/BaseLayout.astro';
import XEmbed from '../components/XEmbed.astro';
import InstagramEmbed from '../components/InstagramEmbed.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../utils/readingTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const allTags = [...new Set(posts.flatMap(p => p.data.tags ?? []))];

const categoryClassMap: Record<string, string> = {
  'ドラマ感想':   'cat-drama',
  '名言まとめ':   'cat-quotes',
  'キャスト・人物': 'cat-cast',
  '史実解説':     'cat-history',
  '考察':         'cat-analysis',
};
function catClass(cat?: string) {
  return cat ? (categoryClassMap[cat] ?? 'cat-default') : 'cat-default';
}

function excerpt(description: string) {
  return description.length > 130 ? description.slice(0, 130) + '…' : description;
}

const featuredPost = posts[0];

const seriesLinks = [
  { label: 'ドラマ感想',   tag: 'ドラマ感想',   emoji: '🎬', desc: '各話レビュー' },
  { label: '名言まとめ',   tag: '名言まとめ',   emoji: '💬', desc: '心に刺さる言葉' },
  { label: 'キャスト・人物', tag: 'キャスト・人物', emoji: '👥', desc: '俳優・登場人物' },
  { label: '史実解説',     tag: '史実解説',     emoji: '📜', desc: '豊臣秀長の実像' },
  { label: '考察',         tag: '考察',         emoji: '🔍', desc: '伏線・深読み' },
];

const catCounts: Record<string, number> = {};
for (const s of seriesLinks) {
  catCounts[s.tag] = posts.filter(p =>
    p.data.tags?.includes(s.tag) || p.data.category === s.tag
  ).length;
}
---

<BaseLayout title="ホーム">
  <!-- ヒーローバナー -->
  <section class="hero-banner" slot="full-width">
    <div class="hero-banner-inner">
      <div class="hero-text">
        <span class="hero-eyecatch">🏯</span>
        <h1 class="hero-catchphrase">NHK大河ドラマ<br>「豊臣兄弟！」を<br>深く楽しむ</h1>
        <p class="hero-sub">感想・考察・キャスト・名言・史実解説をまとめたファンブログ</p>
        <div class="hero-cta">
          <a href="#articles" class="hero-btn-primary">記事を読む →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- シリーズで読む -->
  {seriesLinks.some(s => catCounts[s.tag] > 0) && (
    <section class="series-read-section fade-in-up">
      <p class="series-read-heading">カテゴリで読む</p>
      <div class="series-read-grid">
        {seriesLinks.map(s => (
          <a href={`${base}tags/${encodeURIComponent(s.tag)}/`} class="series-read-card">
            <span class="series-read-emoji">{s.emoji}</span>
            <span class="series-read-label">{s.label}</span>
            <span class="series-read-count">{catCounts[s.tag]}本</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- 公式SNS最新情報 -->
  <section class="sns-section fade-in-up">
    <p class="sns-heading">📱 公式X（@nhk_toyotomi）最新情報</p>
    <div class="sns-grid">
      <XEmbed url="https://x.com/nhk_toyotomi/status/2044249696047378704" />
      <XEmbed url="https://x.com/nhk_toyotomi/status/2011710389323698353" />
      <XEmbed url="https://x.com/nhk_toyotomi/status/2007391745101979762" />
    </div>
    <div class="sns-more">
      <a href="https://x.com/nhk_toyotomi" target="_blank" rel="noopener noreferrer" class="sns-follow-btn">
        𝕏 公式アカウントをフォローする →
      </a>
    </div>
  </section>

  <!-- 公式Instagram -->
  <section class="instagram-section fade-in-up">
    <p class="sns-heading">📸 公式Instagram（@nhk_toyotomi）</p>
    <div class="instagram-grid">
      <InstagramEmbed url="https://www.instagram.com/reel/DVGLmOSE7Oi/" />
      <InstagramEmbed url="https://www.instagram.com/p/DTXn-1_ClBt/" />
      <InstagramEmbed url="https://www.instagram.com/reel/DT7tKpDDw9_/" />
    </div>
    <div class="sns-more">
      <a href="https://www.instagram.com/nhk_toyotomi/" target="_blank" rel="noopener noreferrer" class="instagram-follow-btn">
        📷 公式Instagramをフォローする →
      </a>
    </div>
  </section>

  <!-- おすすめの1本 -->
  {featuredPost && (
    <section class="featured-section fade-in-up">
      <p class="featured-label">最新記事</p>
      <a href={`${base}blog/${featuredPost.slug}/`} class="featured-banner">
        {featuredPost.data.eyecatch
          ? <img src={featuredPost.data.eyecatch} alt={featuredPost.data.title} class="featured-banner-img" loading="lazy" decoding="async" />
          : <div class="featured-banner-img" style="background: linear-gradient(135deg,#450A0A,#7F1D1D);"></div>
        }
        <div class="featured-banner-body">
          {featuredPost.data.category && <span class="featured-badge">{featuredPost.data.category}</span>}
          <p class="featured-title">{featuredPost.data.title}</p>
          <p class="featured-desc">{excerpt(featuredPost.data.description)}</p>
          <p class="featured-meta">📅 {featuredPost.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        </div>
      </a>
    </section>
  )}

  <!-- 記事一覧 -->
  <section id="articles">
    <div class="tag-filter" id="tagFilter">
      <button class="filter-btn active" data-tag="all">すべて</button>
      {allTags.map(tag => (
        <button class="filter-btn" data-tag={tag}>{tag}</button>
      ))}
    </div>

    <ul class="post-list" id="postList" role="list">
      {posts.map((post, i) => {
        const url = `${base}blog/${post.slug}/`;
        const date = post.data.pubDate.toLocaleDateString('ja-JP', {
          year: 'numeric', month: 'long', day: 'numeric',
        });
        const minutes = readingTime(post.body);
        const tagsJson = JSON.stringify(post.data.tags ?? []);
        const cc = catClass(post.data.category);
        const desc = excerpt(post.data.description);
        return (
          <li data-tags={tagsJson} class="fade-in-up" style={`transition-delay: ${Math.min(i * 40, 400)}ms`}>
            <a href={url} class="post-card" style="display:block;text-decoration:none;">
              {post.data.eyecatch && (
                <img src={post.data.eyecatch} alt={post.data.title} class="post-card-eyecatch" loading="lazy" decoding="async" />
              )}
              <div class="post-card-body">
                {post.data.category && (
                  <span class={`category-badge ${cc}`}>{post.data.category}</span>
                )}
                <h2 class="post-card-title">{post.data.title}</h2>
                <p class="post-card-desc">{desc}</p>
                <div class="post-card-meta">
                  <time class="post-date" datetime={post.data.pubDate.toISOString()}>📅 {date}</time>
                  <span class="reading-time">📖 約{minutes}分</span>
                  {post.data.tags?.slice(0, 2).map(tag => <span class="tag">{tag}</span>)}
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
    <p class="no-results" id="noResults" style="display:none;">該当する記事がありません。</p>
  </section>
</BaseLayout>

<!-- X (Twitter) ウィジェット読み込み -->
<script async src="https://platform.twitter.com/widgets.js" charset="utf-8" is:inline></script>

<!-- Instagram 埋め込みスクリプト -->
<script async src="//www.instagram.com/embed.js" is:inline></script>

<style>
  .sns-section {
    margin: 2rem 0 2.5rem;
  }
  .sns-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.2rem;
  }
  .sns-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .sns-more {
    text-align: center;
    margin-top: 1.2rem;
  }
  .sns-follow-btn {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    background: #000;
    color: #fff;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .sns-follow-btn:hover {
    opacity: 0.75;
  }
  .instagram-section {
    margin: 2rem 0 2.5rem;
  }
  .instagram-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    align-items: start;
  }
  .instagram-follow-btn {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    color: #fff;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .instagram-follow-btn:hover {
    opacity: 0.8;
  }
  @media (max-width: 640px) {
    .sns-grid,
    .instagram-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLLIElement>('#postList li');
  const noResults = document.getElementById('noResults')!;

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const selected = btn.dataset.tag!;
      let visible = 0;

      items.forEach(item => {
        const tags: string[] = JSON.parse(item.dataset.tags || '[]');
        const show = selected === 'all' || tags.includes(selected);
        item.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      noResults.style.display = visible === 0 ? 'block' : 'none';
    });
  });
</script>
